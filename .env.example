# Plantilla de variables de entorno. Copiala a `.env` (`cp .env.example .env`)
# y completá los valores: `.env` está en .gitignore y NO se commitea nunca.

# Nodo RPC de Polygon Amoy (chainId 80002). Lo consume `[rpc_endpoints]` de
# foundry.toml para `--rpc-url amoy`, y es el mismo que declara config.js.
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Opcional: API key del explorador (PolygonScan / Etherscan v2), sólo para
# verificar el contrato con `forge verify-contract`. Sin ella el deploy anda igual.
ETHERSCAN_API_KEY=

# ── Acá NO va ninguna clave privada ────────────────────────────────────────
# El `.env` no lleva claves: el deployer se firma con el KEYSTORE de Foundry, que
# guarda la clave cifrada fuera del repo.
#
# Se importa UNA sola vez (pide la clave privada y una password para cifrarla):
#
#   cast wallet import deployer --interactive
#
# Y después el deploy se corre con el nombre de esa cuenta:
#
#   bun run deploy:amoy      # = forge script … --account deployer
#
# La password del keystore la pide Foundry justo al correr `bun run deploy:amoy`,
# y no se guarda en ningún archivo del proyecto. La clave privada nunca aparece
# en la línea de comandos ni en la salida del script.
#
# Con una clave privada también se puede —agregando acá `PRIVATE_KEY=0x…` y
# pasando `--private-key` en la línea de comandos—, pero la vía recomendada es el
# keystore: la clave no queda escrita en el repo ni en el historial del shell.
